# ── Follow-Bench runtime artifacts ──────────────────────────────────────────
# Per-trial evaluation logs (default location of `evaluate.sh` / `run_demo.sh`).
# Override with FOLLOWBENCH_LOG_DIR if you want to keep them elsewhere.
/logs/

# Aggregated visualization figures (default location of constants.py).
# Override with FOLLOWBENCH_EVAL_RESULTS if you want to keep them elsewhere.
/eval_results/

# matplotlib cache directory commonly created by headless eval
/matplotlib/
